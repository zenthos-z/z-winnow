# ============================================================
# .env.example — z-winnow 环境配置模板
# 复制为 .env 并填入真实值
# ============================================================
#
# 命名规则：
#   - WINNOW_* 前缀优先级最高（项目作用域命名）
#   - 标准名作为回退（如 ANTHROPIC_API_KEY）
#   - 两者同时设置时 WINNOW_* 覆盖标准名
#
# 优先级：CLI 参数 > WINNOW_* 环境变量 > 标准环境变量 > .env > Field 默认值
#
# ⚠️  此文件可以提交到 Git（不含真实密钥）
# ⚠️  .env 文件已加入 .gitignore，切勿提交

# ============================================================
# API 密钥
# ============================================================

# Anthropic API 密钥（可选 —— 本项目默认走 DeepSeek；如需 Claude 模型再配）
# 使用第三方中转 API：填代理 Key 并配置 ANTHROPIC_BASE_URL
WINNOW_ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY=

# Anthropic 兼容 API 端点（第三方中转代理地址）
# 留空 = 使用 Anthropic 官方 API (https://api.anthropic.com)
# 填写 = 使用 OpenAI 兼容协议连接代理（如 openrouter、oneapi 等）
WINNOW_ANTHROPIC_BASE_URL=
ANTHROPIC_BASE_URL=

# DeepSeek API 密钥 —— 本项目默认 provider（orchestrator_provider=deepseek）
# 必填：是（核心 LLM 调用走此）；获取地址 https://platform.deepseek.com
WINNOW_DEEPSEEK_API_KEY=sk-...
DEEPSEEK_API_KEY=sk-...

# DeepSeek API 端点（默认官方地址）
WINNOW_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# OpenAI 兼容 API 密钥（可选，可复用 DeepSeek Key）
WINNOW_OPENAI_API_KEY=
OPENAI_API_KEY=

# LangSmith API 密钥（可选，用于 LLM 调用追踪和可观测性）
# 留空 = 优雅禁用追踪，不报错
# 获取地址：https://smith.langchain.com
WINNOW_LANGSMITH_API_KEY=
LANGSMITH_API_KEY=

# WeFlow API 认证 Token（legacy /api/v1/ 数据源）
# 仅当 WINNOW_DATA_SOURCE=weflow 时生效；weflow 服务要求 token，需填真实值
WINNOW_WEFLOW_TOKEN=
WEFLOW_TOKEN=

# ============================================================
# 模型配置
# ============================================================

# Anthropic 模型（可选；仅 orchestrator_provider=anthropic 时用）
WINNOW_ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# DeepSeek 模型（本项目默认；deepseek-v4-flash 含 reasoning，旧 deepseek-chat/reasoner 已废弃）
WINNOW_DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MODEL=deepseek-v4-flash

# Orchestrator 编排模型（默认 DeepSeek；任务拆解和路由决策）
WINNOW_ORCHESTRATOR_MODEL=deepseek-v4-flash
ORCHESTRATOR_MODEL=deepseek-v4-flash

# Orchestrator provider 路由：deepseek（默认）| openai | anthropic
WINNOW_ORCHESTRATOR_PROVIDER=deepseek
ORCHESTRATOR_PROVIDER=deepseek

# ============================================================
# 子 Agent 模型覆盖（留空 = 继承 orchestrator 模型）
# 可用于为特定 Agent 指定不同的模型
# ============================================================
WINNOW_UNIFIED_REPORTER_MODEL=
UNIFIED_REPORTER_MODEL=
WINNOW_OUTPUT_COMPOSER_MODEL=
OUTPUT_COMPOSER_MODEL=
WINNOW_TOPIC_TRACKER_MODEL=
TOPIC_TRACKER_MODEL=

# ============================================================
# 数据库
# ============================================================
# SQLite 默认（无需额外配置）。如需 PostgreSQL：
# DATABASE_URL=postgresql://user:pass@localhost:5432/winnow
WINNOW_DATABASE_URL=sqlite:///data/winnow.db
DATABASE_URL=sqlite:///data/winnow.db

# ============================================================
# 数据源选择 + WeFlow API（legacy /api/v1/ 群聊数据源）
# ============================================================
# 数据源: ciphertalk (默认, /v1/ API) 或 weflow (legacy /api/v1/ API)
WINNOW_DATA_SOURCE=ciphertalk
# WeFlow API 地址 + token（仅 data_source=weflow 时生效）
WINNOW_WEFLOW_BASE_URL=http://127.0.0.1:5031
WEFLOW_BASE_URL=http://127.0.0.1:5031

# ============================================================
# LangSmith 追踪（可选）
# ============================================================
# 项目名（在 LangSmith 仪表板中显示）
WINNOW_LANGSMITH_PROJECT=z-winnow
LANGSMITH_PROJECT=z-winnow
# 是否启用 LangSmith 追踪（true/false）
WINNOW_LANGSMITH_TRACING_V2=true
LANGSMITH_TRACING_V2=true

# ============================================================
# 运行限制 & 超时配置 (P008 / L020 / A009)
# ============================================================
#
# ═══════════════════════════════════════════════════════════════
# 超时类型区分 (L020: 25x 超时教训 — T-A1 设定 600s 实际 15030s)
# ═══════════════════════════════════════════════════════════════
#   - 派发超时 (dispatch timeout): Box0/harness 等待 agent 返回的最长时限.
#     轻型任务 300s, 复杂任务 (>=3 文件 + >=15 tests) 600-900s.
#     Box0 daemon 300s 硬超时直接 SIGKILL (A009 风险).
#   - 执行超时 (execution timeout): agent/node 内部完成操作的时限.
#     按 P008 模型校准: 历史 P95 耗时 × 1.5.
#
# 最大上下文 Token 数
WINNOW_MAX_CONTEXT_TOKENS=128000
MAX_CONTEXT_TOKENS=128000

# ═══════════════════════════════════════════════════════════════
# GRAPH_NODE_TIMEOUT — 默认 graph 节点执行超时 (P008 校准)
# ═══════════════════════════════════════════════════════════════
# P008 推算依据 (基于 progress.json timings):
#   - data_fetch ~10s, content_enrich ~180s, subagents ~30-60s each
#   - P95 ≈ 200s → × 1.5 = 300s (默认值)
# L020: 此为执行超时 (node 内部完成), 非派发超时 (harness 等待)
# A009: 所有节点执行超时 ≤ 300s (Box0 daemon 硬杀阈值)
# 覆盖节点: data_fetch, content_enrich, orchestrator, output_composer,
#           persist 等 StateGraph 中所有非子 agent 节点
WINNOW_GRAPH_NODE_TIMEOUT=300
GRAPH_NODE_TIMEOUT=300

# ═══════════════════════════════════════════════════════════════
# SUBAGENT_TIMEOUT_SECONDS — 子 agent 执行超时 (P008 校准)
# ═══════════════════════════════════════════════════════════════
# P008 推算依据 (基于 progress.json timings):
#   - subagents P95 ~60-80s → × 1.5 ≈ 120s (默认值)
# L020: 此为执行超时 (agent/node 内部完成), 非派发超时 (harness 等待)
# A009: 120s 执行超时 < 300s Box0 硬杀阈值, 安全
# 适用: graph/nodes/recovery.py DEFAULT_SUBAGENT_TIMEOUT 从 env 读取
WINNOW_SUBAGENT_TIMEOUT_SECONDS=120
SUBAGENT_TIMEOUT_SECONDS=120

# ═══════════════════════════════════════════════════════════════
# CONTENT_ENRICH_TIMEOUT — 内容增强节点超时 (已有配置，保持不变)
# ═══════════════════════════════════════════════════════════════
# P008: 180s 默认值, content_enrich/__init__.py 中 read via os.getenv
# A009: 180s 执行超时 < 300s Box0 硬杀阈值, 安全
# 此为执行超时, 由 content_enrich 节点内部 asyncio.wait_for 使用
# 注意: 此 env var 在 content_enrich/__init__.py 中直接 read, 不经过 pydantic-settings
CONTENT_ENRICH_TIMEOUT=180

# ============================================================
# 日志
# ============================================================
# 日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL
WINNOW_LOG_LEVEL=INFO
LOG_LEVEL=INFO

# ============================================================
# 存储路径
# ============================================================
WINNOW_SQLITE_DB_PATH=data/winnow.db
SQLITE_DB_PATH=data/winnow.db
WINNOW_MEMORY_DIR=memory
MEMORY_DIR=memory
WINNOW_REPORTS_DIR=reports
REPORTS_DIR=reports

# ============================================================
# 图片分析 (Vision API)
# 对群聊中的图片消息进行 AI 视觉分析，产出结构化文字描述
# 未配置时自动降级为旧行为 [图片: media_url]
# ============================================================
# Vision API 模型名称，用于图片内容分析
# 留空 = 降级到 MCP 模式 (MCP_IMAGE_ANALYSIS=true) 或 disabled 模式
WINNOW_VISION_MODEL=claude-sonnet-4-20250514
VISION_MODEL=claude-sonnet-4-20250514
# 当 VISION_MODEL 未设置时，是否启用 MCP analyze_image 工具回退
# 可选值: true / false / 1 / yes
WINNOW_MCP_IMAGE_ANALYSIS=false
MCP_IMAGE_ANALYSIS=false
# 图片分析批处理最大并发数 (asyncio.Semaphore)
WINNOW_IMAGE_MAX_CONCURRENCY=5
IMAGE_MAX_CONCURRENCY=5
# 单张图片最大文件大小 (MB)，超出跳过并记录 WARNING
WINNOW_IMAGE_MAX_FILE_SIZE_MB=20
IMAGE_MAX_FILE_SIZE_MB=20
# 支持的图片格式列表 (逗号分隔，大小写不敏感)
WINNOW_SUPPORTED_IMAGE_FORMATS=PNG,JPG,JPEG,GIF,WebP
SUPPORTED_IMAGE_FORMATS=PNG,JPG,JPEG,GIF,WebP

# ============================================================
# 飞书多维表格输出（可选，默认禁用）
# 凭证来源：旧 winnow 项目 temp/feishu_upload_*.json
# ============================================================
# 是否启用飞书上传（true/false）
WINNOW_FEISHU_ENABLED=false
FEISHU_ENABLED=false
# 飞书多维表格应用 Token（旧项目已配置）
WINNOW_FEISHU_BITABLE_ID=XgifbiqYMag2k4srFF4cPb5qnwe
FEISHU_BITABLE_ID=XgifbiqYMag2k4srFF4cPb5qnwe
# 资源表 ID（旧项目已配置）
WINNOW_FEISHU_TABLE_ID=tblmHUYTQecNOu4r
FEISHU_TABLE_ID=tblmHUYTQecNOu4r
# 旧项目其他飞书凭证（供参考）：
#   工程问题表：tblOk0QT5EQtvYSW
#   Bot User ID：ou_01217f67208740d595a1d869a9d4fb31

# ============================================================
# 配图生成（可选，DMX Gemini API）
# ============================================================
WINNOW_QUICK_IMG_API_KEY=
QUICK_IMG_API_KEY=

# ============================================================
# mem0 长期记忆（预留，暂未启用）
# ============================================================
WINNOW_MEM0_API_KEY=
MEM0_API_KEY=
WINNOW_MEM0_ORG_ID=
MEM0_ORG_ID=

# ============================================================
# MemOS 记忆系统（可选，默认禁用）
# 通过 Neo4j + Qdrant + MemOS API 实现长期记忆管理
# MEMOS_ENABLED=false 时所有 MemOS 代码路径零副作用
# ============================================================

# 是否启用 MemOS 记忆系统（true/false）
# 默认 false — 保证向后兼容，现有流程不受影响
WINNOW_MEMOS_ENABLED=false
MEMOS_ENABLED=false

# MemOS API 服务地址
# Docker 部署时使用 http://memos-api:8000（容器间通信）
# 本地开发时使用 http://localhost:8000
WINNOW_MEMOS_API_URL=http://localhost:8000
MEMOS_API_URL=http://localhost:8000

# MemOS Cube 命名前缀（用于区分不同部署实例）
# 所有 MemOS Cube 名称将以该前缀开头
WINNOW_MEMOS_CUBE_PREFIX=winnow
MEMOS_CUBE_PREFIX=winnow

# ---- Neo4j 图数据库 ----
# Neo4j 连接 URI（bolt 协议）
WINNOW_NEO4J_URI=bolt://localhost:7687
NEO4J_URI=bolt://localhost:7687

# Neo4j 认证用户名
WINNOW_NEO4J_USER=neo4j
NEO4J_USER=neo4j

# Neo4j 认证密码（生产环境务必修改）
WINNOW_NEO4J_PASSWORD=memos_password
NEO4J_PASSWORD=memos_password

# Neo4j 数据库名称（默认 neo4j）
WINNOW_NEO4J_DB_NAME=neo4j
NEO4J_DB_NAME=neo4j

# ---- MemOS 模型配置 ----
# MemOS 对话模型：裸 model-name，不带 provider/ 前缀（MemOS 拒绝前缀名，如 openai/gpt-4o-mini）
WINNOW_MOS_CHAT_MODEL=deepseek-v4-flash
MOS_CHAT_MODEL=deepseek-v4-flash

# MemOS Embedding 模型（对齐 docker-compose memos-api：text-embedding-3-large / 3072）
WINNOW_MOS_EMBEDDER_MODEL=openai/text-embedding-3-large
MOS_EMBEDDER_MODEL=openai/text-embedding-3-large

# MemOS Embedding 后端提供者
WINNOW_MOS_EMBEDDER_BACKEND=openai
MOS_EMBEDDER_BACKEND=openai

# Embedding 向量维度（需与模型匹配：large=3072）
WINNOW_EMBEDDING_DIMENSION=3072
EMBEDDING_DIMENSION=3072

# MemOS Reranker 后端提供者
WINNOW_MOS_RERANKER_BACKEND=openai
MOS_RERANKER_BACKEND=openai

# ============================================================
# MCP 部署 + ECS 同步（公网服务 mcp.example.com）
# 本地开发可不配；部署公网 MCP / sync push/pull 时必填
# ============================================================

# 部署目标：local（默认，本地 stdio 单库）| ecs（公网 http 双库 + key 鉴权）
WINNOW_DEPLOYMENT_TARGET=local

# MCP key 注册表（key→成员+群组白名单；gitignored；winnow mcp-key 管理；sync push 推 ECS）
WINNOW_MCP_KEYS_PATH=config/mcp_keys.yaml

# ECS 双库路径（仅 deployment_target=ecs 时用）
WINNOW_L3_SNAPSHOT_PATH=data/l3_snapshot.db
WINNOW_FEEDBACK_INBOX_PATH=data/feedback_inbox.db

# ECS SSH 连接（sync push/pull 目标；仅部署公网 MCP 时配）
WINNOW_ECS_SSH_HOST=
WINNOW_ECS_SSH_USER=root
WINNOW_ECS_SSH_KEY=
WINNOW_ECS_DATA_DIR=/opt/winnow-mcp-data
WINNOW_ECS_CONTAINER_NAME=winnow-mcp

# ============================================================
# 对象存储 Cloudflare R2（附件上传；MCP 公网可下载）
# ============================================================
# 私有桶：resource 记 cloud_key；MCP serve 时按 cloud_key 生成短期预签名
# cloud_url（默认 1h 失效）→ 远程 agent 下载图片/PDF/文件。本地 web 仍走
# local_url（读本地盘）。飞书上传不受影响（仍读 local_path）。
#
# 凭证：R2 控制台 → Manage R2 API Tokens → 新建『S3 API』token，
# 取 Access Key ID + Secret Access Key（cfut_ 开头是账户管理 token，不能用于 S3）。
#   · 本地（上传）：用完整读写 token
#   · ECS（仅预签名，只读即可）：建议另建一个只读 token，配进 ECS 容器 env
# ============================================================
WINNOW_R2_UPLOAD_ENABLED=false
WINNOW_R2_ENDPOINT=https://13715d2931cb4af40d527e1253e30a1b.r2.cloudflarestorage.com
WINNOW_R2_BUCKET=winnow-mcp
WINNOW_R2_ACCESS_KEY_ID=
WINNOW_R2_SECRET_ACCESS_KEY=
WINNOW_R2_PRESIGNED_EXPIRY=3600
# 国内直连 R2 签名读会卡死（curl 裸 GET 通但 boto3 读超时），走 Clash 代理秒通。
# 仅本地配；ECS 无需（只预签名，不发网络）
WINNOW_R2_HTTPS_PROXY=
